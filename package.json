{
  "name": "lazyreview",
  "version": "0.2.0",
  "description": "A terminal UI for reviewing git changes with syntax highlighting",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "lazyreview": "./index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandrade2/lazyreview.git"
  },
  "homepage": "https://github.com/mandrade2/lazyreview",
  "bugs": {
    "url": "https://github.com/mandrade2/lazyreview/issues"
  },
  "keywords": [
    "git",
    "diff",
    "code-review",
    "terminal",
    "tui",
    "cli",
    "syntax-highlighting"
  ],
  "author": "Matías Andrade",
  "license": "MIT",
  "scripts": {
    "build": "bun run script/build.ts",
    "build:local": "bun run script/build.ts --single",
    "release": "bun run script/release.ts",
    "bench": "bun run script/benchmark.ts",
    "test": "bun test",
    "test:preview": "bun run tests/preview.ts",
    "preview": "bun run test:preview golden 120 50",
    "replay": "bun run tests/preview.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.4.0",
    "@opentui/solid": "0.4.0",
    "shiki": "^4.2.0",
    "solid-js": "^1.9.13"
  }
}
